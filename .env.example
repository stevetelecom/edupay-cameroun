# ── Application ──────────────────────────────────────────────
APP_NAME="EduPay Cameroun"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# --- CORS (API consommee par l'app mobile React Native) ---
# Origines autorisees, separees par des virgules. `*` par defaut : le port Expo
# change selon le lancement (8081, 8099, 19006) et selon l'appareil.
# En production, restreindre si possible :
# CORS_ALLOWED_ORIGINS=https://edupay.mekontso.gsi2026.com
CORS_ALLOWED_ORIGINS=*
# Regex d'origines a domaine variable (tunnel ngrok, IP de poste), separees par
# des virgules. Vide par defaut.
CORS_ALLOWED_ORIGIN_PATTERNS=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Douala

# ── Base de données ───────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sessions & Cache ─────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Mail (dev : Mailtrap) ─────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=89485cd723362c
MAIL_PASSWORD=****c7de
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@edupay.cm
MAIL_FROM_NAME="EduPay Cameroun"

# ── SMS (Africa's Talking) ────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=EduPay

# ── MTN Mobile Money ─────────────────────────────────────────
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENV=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# ── Orange Money ─────────────────────────────────────────────
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MOMO_ENV=sandbox

# ── CinetPay (Carte bancaire) ─────────────────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_ENV=sandbox



# ── Sanctum ──────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# ── AangaraaPay ──────────────────────────────────────
AANGARAA_API_URL=https://api-production.aangaraa-pay.com/api/v1
AANGARAA_APP_KEY=TEST_KEY_DEV
# URL publique du webhook (obligatoire en prod si APP_URL ≠ domaine réel)
# AANGARAA_NOTIFY_URL=https://edupay.mekontso.qsi2026.com/webhook/aangaraapay

EDUPAY_TAUX_COMMISSION=0.025
EDUPAY_TIMEOUT_PAIEMENT=120
EDUPAY_MAX_TRANCHES=3
EDUPAY_SMS_ACTIF=true
EDUPAY_MAINTENANCE=false
# ── Connexion Google (Socialite) — OAuth 2.0 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TON-DOMAINE/auth/google/callback
SEED_DEMO_PASSWORD=

# Telephone de l'etablissement de demonstration UD-2026 (ProdCoreAccountsSeeder).
# 9 chiffres, debutant par 2, 3 ou 6. Requis : la colonne est NOT NULL.
SEED_ETABLISSEMENT_TELEPHONE=
